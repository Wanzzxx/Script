local function num(v)
  if typeof(v)=="number" then return v end
  if v==nil then return nil end
  local s=tostring(v)
  if s:lower():find("max") then return math.huge end
  s=s:gsub("[%$,%s]","")
  local n,suf=s:match("(%d[%d%.]*)(%a*)")
  n=tonumber(n)
  if not n then return nil end
  if not suf or suf=="" then return n end
  suf=suf:lower()
  local mult=1
  local baseMap={k=3,m=6,b=9,t=12,qa=15,qi=18,sx=21,sp=24,oc=27,no=30,dc=33,ud=36,dd=39,td=42,qad=45,qid=48,sxd=51,spd=54,ocd=57,nod=60,vg=63}
  local p=baseMap[suf]
  if p then
    mult=10^p
  else
    mult=10^(3*#suf)
  end
  return n*mult
end

local function get(r,...)
  for _,n in ipairs({...}) do
    if not r then return end
    r=r:FindFirstChild(n)
  end
  return r
end

local function spot() return get(W,"LocalPlotProps","TrainingArea","TrainingSpot") end
local function btn() return get(spot(),"UpgradeButton") end
local function priceL() return get(btn(),"PriceAnchor","PriceBillboard","Holder","PriceHolder","Price") end
local function moneyRaw()
  local m=get(plr,"leaderstats","Money")
  return m and m.Value
end
local function power()
  local p=get(plr,"leaderstats","Throw Power")
  return p and p.Value
end

local function inv(n,...)
  local r=R and R:FindFirstChild(n)
  if not r then return end
  local a=table.pack(...)
  pcall(function()
    if r:IsA("RemoteEvent") then r:FireServer(table.unpack(a,1,a.n))
    else r:InvokeServer(table.unpack(a,1,a.n)) end
  end)
end

local function root()
  local c=plr.Character
  return c and c:FindFirstChild("HumanoidRootPart")
end
local function tp(i)
  local h=root()
  if h and i and i:IsA("PVInstance") then
    h.CFrame=i:GetPivot()+Vector3.new(0,3,0)
    h.AssemblyLinearVelocity=Vector3.zero
  end
end
local function dist(i)
  local h=root()
  if h and i then return (h.Position-i:GetPivot().Position).Magnitude end
  return math.huge
end

local run,on,mode,training=true,true,"train",false
local status,ups,retry,t0="Starting",0,0,os.clock()
local lastPow,lastChg=nil,os.clock()

local function resetP()
  lastPow=nil
  lastChg=os.clock()
end
local function stalled()
  local v=power()
  if v==nil then return false end
  if lastPow==nil or v>lastPow then lastChg=os.clock() end
  lastPow=v
  return os.clock()-lastChg>=STALL
end

local function isMaxUpgrades()
  local pl = priceL()
  if pl and pl.Text and pl.Text:lower():find("max") then
    return true
  end
  return false
end

local function ready()
  if isMaxUpgrades() then return false end
  if os.clock()<retry then return false end
  local m,p=num(moneyRaw()),num((priceL() or {}).Text)
  return m~=nil and p~=nil and m>=p
end

plr.CharacterAdded:Connect(function()
  training=false
  resetP()
end)

local samples,since,lastM,lastP,rate,focus,weak={},nil,nil,nil,0,false,false
local function resetInc()
  table.clear(samples)
  since,lastM,rate,focus,weak=nil,nil,0,false,false
end
local function income()
  local now=os.clock()
  local pl=priceL()
  local pt=pl and pl.Text
  local m,p=num(moneyRaw()),pt and num(pt)
  if not (m and p and p>0) then return end
  if pt~=lastP then
    lastP=pt
    resetInc()
  end
  if lastM then
    table.insert(samples,{now,math.max(0,m-lastM)/p*100})
  else
    since=now
  end
  lastM=m
  while samples[1] and samples[1][1]<now-WIN do table.remove(samples,1) end
  local span=math.min(WIN,now-since)
  if span<MINSPAN then
    rate=0
    return
  end
  local tot=0
  for _,s in ipairs(samples) do tot=tot+s[2] end
  rate=tot/span
  if rate>=FOCUS then focus,weak=true,false
  elseif rate<FOCUS*0.5 then focus=false end
  if rate<=WEAK then weak,focus=true,false
  elseif rate>WEAK*1.25 then weak=false end
end
local function leave() return ready() or focus or isMaxUpgrades() end

local function startT()
  status="Training"
  tp(spot())
  task.wait(0.3)
  inv("Training_Start")
  training=true
  resetP()
end
local function stopT()
  if training then
    inv("Training_Stop")
    training=false
  end
end

local function changed(old,oldV)
  local l=priceL()
  if not l or l.Text==old then return false end
  local n=num(l.Text)
  if oldV and n then return n>oldV end
  return true
end
local function doUp()
  status="Upgrading tool"
  stopT()
  local b,l=btn(),priceL()
  if not (b and l) then return false end
  tp(b)
  task.wait(0.4)
  local old=l.Text
  local oldV=num(old)
  local dl=os.clock()+30
  while run and on do
    if changed(old,oldV) then return true end
    if os.clock()>=dl then return false end
    b=btn()
    if not b then return false end
    if dist(b)>12 then
      tp(b)
      task.wait(0.2)
    end
    status="Upgrading - pressing E"
    local pr=get(b,"ProximityPrompt")
    if pr and fireproximityprompt then pcall(fireproximityprompt,pr) end
    VIM:SendKeyEvent(true,Enum.KeyCode.E,false,game)
    task.wait((pr and pr.HoldDuration or 0)+0.15)
    VIM:SendKeyEvent(false,Enum.KeyCode.E,false,game)
    task.wait(0.1)
  end
  return false
end

local function active()
  local pg=plr:FindFirstChild("PlayerGui")
  local x=pg and pg:FindFirstChild("ThrowSequence",true)
  while x and x~=game do
    if x:IsA("ScreenGui") then return x.Enabled end
    if x:IsA("GuiObject") and not x.Visible then return false end
    x=x.Parent
  end
  return x~=nil
end
local function tap()
  local s=W.CurrentCamera.ViewportSize
  VIM:SendMouseButtonEvent(s.X/2,s.Y/2,0,true,game,0)
  VIM:SendMouseButtonEvent(s.X/2,s.Y/2,0,false,game,0)
end
local function waitGui()
  local n=0
  while run and on and not leave() do
    if active() then return true end
    local a=W:FindFirstChild("StarterArea")
    if not a then
      status="Farm area not found"
      task.wait(1)
    else
      n=n+1
      status="Attempt to Farm #"..n
      tp(a)
      local t=os.clock()
      while os.clock()-t<1 do
        if not (run and on) or leave() then return false end
        if active() then return true end
        task.wait(0.05)
      end
    end
  end
  return false
end
local function catch()
  status="Perfect Throwing..."
  local f,nt=os.clock(),os.clock()
  while run and on and not leave() and active() do
    local now=os.clock()
    if now>=f then
      task.spawn(inv,"Throw_Resolve",1)
      f=now+0.95
    end
    if now>=nt then
      tap()
      nt=now+TAP
    end
    task.wait(0.05)
  end
end
local function farm()
  if waitGui() then catch() end
end

